# Normalize line endings for text files.
* text=auto eol=lf

# Files the game loads at runtime (images, SVGs, compressed audio, fonts)
# stay in plain Git. The browser build and Vercel need the real files, and
# plain Git means nobody needs an LFS login to get a working copy.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ogg   binary
*.mp3   binary
*.m4a   binary
*.mp4   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Large source and master files the game never loads go through Git LFS.
# Export a compressed copy (.png/.webp, .ogg/.mp3) for the game to use.
*.psd   filter=lfs diff=lfs merge=lfs -text
*.kra   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
