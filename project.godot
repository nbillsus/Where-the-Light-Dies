[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="keeper"
3d_physics/layer_3="shadow"
3d_physics/layer_4="enemies"
3d_physics/layer_5="pushable"
3d_physics/layer_6="grates"
3d_physics/layer_7="solid_shadow"
3d_physics/layer_8="triggers"
3d_physics/layer_9="light_blockers"
3d_physics/layer_10="light_receivers"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
